# Copie este arquivo para "backend/.env" e preencha com os valores reais.
# NUNCA envie o .env para o GitHub (ele já está no .gitignore).

# Connection string do PostgreSQL no Neon (painel do Neon > Connect > Copy snippet)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Segredo que assina os tokens de login (mínimo 32 caracteres, cada ambiente o seu).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se ele mudar, todo mundo precisa fazer login de novo.
JWT_SECRET=

# Envio de e-mails (confirmação de conta e "esqueci minha senha") pelo Brevo.
# Sem a chave, o código aparece no terminal do backend (bom para testes).
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Recicle Floripa

# Chave da API do Gemini (Google AI Studio > Chaves de API)
GEMINI_API_KEY=sua-chave-aqui

# Origens extras liberadas no CORS, separadas por vírgula (opcional)
# Ex.: http://192.168.1.11:5173 para testar pelo celular na rede local
CORS_ORIGINS=

# Libera os túneis *.trycloudflare.com no CORS (só para testar no celular)
PERMITIR_TUNEL=false

# Porta do servidor (opcional, padrão 3000)
PORT=3000
