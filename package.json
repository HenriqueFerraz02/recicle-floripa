{
  "name": "recicle-floripa",
  "version": "1.0.0",
  "description": "Recicle Floripa: app de descarte correto de resíduos em Florianópolis, com identificação por IA, ecopontos e gamificação.",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenriqueFerraz02/recicle-floripa.git"
  },
  "keywords": [
    "reciclagem",
    "florianopolis",
    "residuos",
    "gamificacao",
    "ia"
  ],
  "author": "Henrique Hoepers Ferraz, Lucas de Azevedo Corso, Luis Gustavo Angelo",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/HenriqueFerraz02/recicle-floripa/issues"
  },
  "homepage": "https://github.com/HenriqueFerraz02/recicle-floripa#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
