# Copie este arquivo para "frontend/.env.local" e ajuste o endereço do backend.
# O Vite só lê este arquivo ao iniciar: reinicie o "npm run dev" após alterar.

# No PC:                     http://localhost:3000
# Celular na mesma rede:     http://IP-DO-PC:3000
# Celular com câmera (HTTPS): link do túnel do backend (https://....trycloudflare.com)
VITE_API_URL=http://localhost:3000
